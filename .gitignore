# Third-party binaries and model weights are never committed
# (anchored with a leading slash so backend/thrones/runtime/ source is NOT ignored)
/runtime/
/models/*.gguf
/models/*.part

# Local user data (conversations, memory, uploads, settings)
/data/

# Benchmark engine logs (results JSON is kept)
/evals/results/server-*.log

# Environments and caches
.venv/
.cache/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
frontend/dist/

# Training outputs
training/outputs/
training/datasets/raw/

# Secrets
.env
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Training: base weights, downloaded datasets, run outputs (manifests and configs are committed)
/training/base/
/training/datasets/raw/
/training/datasets/*.jsonl
/training/runs/*/checkpoints/
/training/runs/*/merged/
/training/runs/*/*.gguf
/.venv-train/
/training/runs/*/adapter/
/training/runs/pilot/
/unsloth_compiled_cache/
