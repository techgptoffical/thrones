# Third-party binaries and model weights are never committed
# (anchored with a leading slash so backend/thrones/runtime/ source is NOT ignored)
/runtime/
/models/*.gguf
/models/*.part

# Local user data (conversations, memory, uploads, settings)
/data/

# Benchmark engine logs (results JSON is kept)
/evals/results/server-*.log

# Environments and caches
.venv/
.cache/
__pycache__/
*.pyc
.pytest_cache/
node_modules/
frontend/dist/

# Training outputs
training/outputs/
training/datasets/raw/

# Secrets
.env
*.key

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
